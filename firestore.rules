rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCampaignMember() {
      return signedIn() && request.auth.uid in resource.data.members;
    }

    function isIncomingCampaignMember() {
      return signedIn() && request.auth.uid in request.resource.data.members;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /campaigns/{campaignId} {
      // Um usuario autenticado pode buscar uma campanha pelo ID para entrar com a senha da mesa.
      // A lista em tempo real continua restrita a membros via query array-contains.
      allow get: if signedIn();
      allow list: if isCampaignMember();
      allow create: if isIncomingCampaignMember()
        && request.resource.data.masterId == request.auth.uid;
      allow update: if isIncomingCampaignMember();
      allow delete: if signedIn() && resource.data.masterId == request.auth.uid;
    }
  }
}
