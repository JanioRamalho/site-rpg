rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCampaignMember() {
      return signedIn() && request.auth.uid in resource.data.members;
    }

    function isIncomingCampaignMember() {
      return signedIn() && request.auth.uid in request.resource.data.members;
    }

    function campaignPath(campaignId) {
      return /databases/$(database)/documents/campaigns/$(campaignId);
    }

    function playerPath(campaignId, playerId) {
      return /databases/$(database)/documents/campaigns/$(campaignId)/players/$(playerId);
    }

    function isCampaignMemberById(campaignId) {
      return signedIn()
        && request.auth.uid in get(campaignPath(campaignId)).data.members;
    }

    function isCampaignMasterById(campaignId) {
      return signedIn()
        && get(campaignPath(campaignId)).data.masterId == request.auth.uid;
    }

    function hasAuthenticatedEmail() {
      return signedIn() && request.auth.token.email is string;
    }

    function hasPreparedCharacterSlot() {
      return hasAuthenticatedEmail()
        && (
          !resource.data.keys().hasAny(['readyPlayerEmails'])
          || request.auth.token.email.lower() in resource.data.readyPlayerEmails
        );
    }

    function pendingPlayerEmailMatches() {
      return hasAuthenticatedEmail()
        && (
          (resource.data.keys().hasAny(['emailNormalized'])
            && resource.data.emailNormalized == request.auth.token.email.lower())
          || (!resource.data.keys().hasAny(['emailNormalized'])
            && resource.data.email is string
            && resource.data.email.lower() == request.auth.token.email.lower())
        );
    }

    function isOwnIncomingPlayerDoc() {
      return signedIn()
        && request.resource.data.authUid == request.auth.uid;
    }

    function isOwnExistingPlayerDoc() {
      return signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid;
    }

    function isValidPlayerSelfCreate(docId) {
      return isOwnIncomingPlayerDoc()
        && request.resource.data.id == docId
        && request.resource.data.characterId == null
        && request.resource.data.status == 'claimed'
        && request.resource.data.emailNormalized == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'email', 'emailNormalized', 'authUid', 'characterId',
          'status', 'online', 'lastSeen', 'joinedAt', '_order'
        ]);
    }

    function canClaimPendingPlayer() {
      return (!resource.data.keys().hasAny(['authUid']) || resource.data.authUid == null)
        && pendingPlayerEmailMatches()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.characterId == resource.data.characterId
        && request.resource.data.status == 'claimed'
        && request.resource.data.emailNormalized == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'emailNormalized', 'authUid', 'status', 'online',
          'lastSeen', 'joinedAt', '_order'
        ]);
    }

    function isValidOwnPlayerUpdate() {
      return isOwnExistingPlayerDoc()
        && request.resource.data.characterId == resource.data.characterId
        && request.resource.data.status == 'claimed'
        && request.resource.data.emailNormalized == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'emailNormalized', 'status', 'online',
          'lastSeen', 'joinedAt', '_order'
        ]);
    }

    function isOwnIncomingMessageOrLog() {
      return signedIn() && request.resource.data.authorId == request.auth.uid;
    }

    function isOwnIncomingTransfer(campaignId, docId) {
      let sourcePlayer = get(playerPath(campaignId, request.resource.data.fromPlayerId));
      return signedIn()
        && request.resource.data.id == docId
        && request.resource.data.status == 'pending'
        && request.resource.data.fromPlayerId is string
        && exists(playerPath(campaignId, request.resource.data.fromPlayerId))
        && sourcePlayer.data.authUid == request.auth.uid
        && request.resource.data.fromCharacterId == sourcePlayer.data.characterId
        && !request.resource.data.keys().hasAny(['resolvedAt', 'resolvedBy'])
        && (
          request.resource.data.type == 'evidence'
          || (
            request.resource.data.type == 'item'
            && request.resource.data.inventoryId is string
            && request.resource.data.toCharacterId is string
            && request.resource.data.quantity is int
            && request.resource.data.quantity > 0
          )
        );
    }

    function isOwnControlledCharacter(campaignId, characterId) {
      let playerId = request.resource.data.controllerPlayerId;
      return signedIn()
        && playerId is string
        && exists(playerPath(campaignId, playerId))
        && get(playerPath(campaignId, playerId)).data.authUid == request.auth.uid
        && get(playerPath(campaignId, playerId)).data.characterId == characterId;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /campaigns/{campaignId} {
      // A senha atual da mesa e validada no cliente, portanto a busca direta por ID
      // precisa continuar disponivel a usuarios autenticados.
      allow get: if signedIn();
      allow list: if isCampaignMember();
      allow create: if isIncomingCampaignMember()
        && request.resource.data.masterId == request.auth.uid;
      allow update: if (
        signedIn() && resource.data.masterId == request.auth.uid
      ) || (
        isCampaignMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
      ) || (
        signedIn()
        && !(request.auth.uid in resource.data.members)
        && hasPreparedCharacterSlot()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
      );
      allow delete: if signedIn() && resource.data.masterId == request.auth.uid;

      match /players/{docId} {
        allow read: if isCampaignMemberById(campaignId);
        allow create: if isCampaignMemberById(campaignId)
          && (isCampaignMasterById(campaignId) || isValidPlayerSelfCreate(docId));
        allow update: if isCampaignMemberById(campaignId)
          && (isCampaignMasterById(campaignId) || canClaimPendingPlayer() || isValidOwnPlayerUpdate());
        allow delete: if isCampaignMasterById(campaignId);
      }

      match /messages/{docId} {
        allow read: if isCampaignMemberById(campaignId);
        allow create: if isCampaignMemberById(campaignId)
          && (isCampaignMasterById(campaignId) || isOwnIncomingMessageOrLog());
        allow update, delete: if isCampaignMasterById(campaignId);
      }

      match /diceLogs/{docId} {
        allow read: if isCampaignMemberById(campaignId);
        allow create: if isCampaignMemberById(campaignId)
          && (isCampaignMasterById(campaignId) || isOwnIncomingMessageOrLog());
        allow update, delete: if isCampaignMasterById(campaignId);
      }

      match /characters/{docId} {
        allow read: if isCampaignMemberById(campaignId);
        allow create, delete: if isCampaignMasterById(campaignId);
        allow update: if isCampaignMasterById(campaignId) || (
          isCampaignMemberById(campaignId)
          && isOwnControlledCharacter(campaignId, docId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'controllerPlayerId', 'health', 'sanity', 'skills'
          ])
        );
      }

      match /itemTransfers/{docId} {
        allow read: if isCampaignMemberById(campaignId);
        allow create: if isCampaignMemberById(campaignId)
          && (isCampaignMasterById(campaignId) || isOwnIncomingTransfer(campaignId, docId));
        allow update, delete: if isCampaignMasterById(campaignId);
      }

      match /scenes/{docId} {
        allow read, create, update, delete: if isCampaignMasterById(campaignId);
      }

      match /{subcollection}/{docId} {
        allow read: if subcollection != 'scenes'
          && isCampaignMemberById(campaignId);
        allow create, update, delete: if subcollection != 'scenes'
          && isCampaignMasterById(campaignId);
      }
    }
  }
}
