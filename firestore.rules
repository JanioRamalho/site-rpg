rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCampaignMember() {
      return signedIn() && request.auth.uid in resource.data.members;
    }

    function isIncomingCampaignMember() {
      return signedIn() && request.auth.uid in request.resource.data.members;
    }

    function campaignPath(campaignId) {
      return /databases/$(database)/documents/campaigns/$(campaignId);
    }

    function playerPath(campaignId, playerId) {
      return /databases/$(database)/documents/campaigns/$(campaignId)/players/$(playerId);
    }

    function characterPath(campaignId, characterId) {
      return /databases/$(database)/documents/campaigns/$(campaignId)/characters/$(characterId);
    }

    function isCampaignMemberById(campaignId) {
      return signedIn()
        && request.auth.uid in get(campaignPath(campaignId)).data.members;
    }

    function isCampaignMasterById(campaignId) {
      return signedIn()
        && get(campaignPath(campaignId)).data.masterId == request.auth.uid;
    }

    function hasAuthenticatedEmail() {
      return signedIn() && request.auth.token.email is string;
    }

    function hasPreparedCharacterSlot() {
      return hasAuthenticatedEmail()
        && (
          !resource.data.keys().hasAny(['readyPlayerEmails'])
          || request.auth.token.email.lower() in resource.data.readyPlayerEmails
        );
    }

    function pendingPlayerEmailMatches() {
      return hasAuthenticatedEmail()
        && (
          (resource.data.keys().hasAny(['emailNormalized'])
            && resource.data.emailNormalized == request.auth.token.email.lower())
          || (!resource.data.keys().hasAny(['emailNormalized'])
            && resource.data.email is string
            && resource.data.email.lower() == request.auth.token.email.lower())
        );
    }

    function isOwnIncomingPlayerDoc() {
      return signedIn()
        && request.resource.data.authUid == request.auth.uid;
    }

    function isOwnExistingPlayerDoc() {
      return signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid;
    }

    function isValidPlayerSelfCreate(docId) {
      return isOwnIncomingPlayerDoc()
        && request.resource.data.id == docId
        && request.resource.data.characterId == null
        && request.resource.data.status == 'claimed'
        && request.resource.data.emailNormalized == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'email', 'emailNormalized', 'authUid', 'characterId',
          'status', 'online', 'lastSeen', 'joinedAt', '_order'
        ]);
    }

    function canClaimPendingPlayer() {
      return (!resource.data.keys().hasAny(['authUid']) || resource.data.authUid == null)
        && pendingPlayerEmailMatches()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.characterId == resource.data.characterId
        && request.resource.data.status == 'claimed'
        && request.resource.data.emailNormalized == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'emailNormalized', 'authUid', 'status', 'online',
          'lastSeen', 'joinedAt', '_order'
        ]);
    }

    function isValidOwnPlayerUpdate() {
      return isOwnExistingPlayerDoc()
        && request.resource.data.characterId == resource.data.characterId
        && request.resource.data.status == 'claimed'
        && request.resource.data.emailNormalized == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'emailNormalized', 'status', 'online',
          'lastSeen', 'joinedAt', '_order'
        ]);
    }

    function isOwnIncomingMessageOrLog() {
      return signedIn() && request.resource.data.authorId == request.auth.uid;
    }

    function publicChatEnabled(campaignId) {
      let campaign = get(campaignPath(campaignId)).data;
      return !campaign.keys().hasAny(['chatSettings'])
        || campaign.chatSettings.publicEnabled == true;
    }

    function hasPrivateThreadOverride(settings, threadId) {
      return settings.keys().hasAny(['privateThreads'])
        && settings.privateThreads is map
        && settings.privateThreads.keys().hasAny([threadId]);
    }

    function privateChatEnabled(campaignId, threadId) {
      let campaign = get(campaignPath(campaignId)).data;
      return !campaign.keys().hasAny(['chatSettings'])
        || (
          hasPrivateThreadOverride(campaign.chatSettings, threadId)
          && campaign.chatSettings.privateThreads[threadId] == true
        )
        || (
          !hasPrivateThreadOverride(campaign.chatSettings, threadId)
          && (
            !campaign.chatSettings.keys().hasAny(['privateEnabled'])
            || campaign.chatSettings.privateEnabled == true
          )
        );
    }

    function canReadPrivateMessage(campaignId) {
      return isCampaignMasterById(campaignId) || (
        isCampaignMemberById(campaignId)
        && resource.data.accessUid == request.auth.uid
      );
    }

    function isValidPlayerPrivateConversation(campaignId, data) {
      let playerIds = data.participantPlayerIds;
      let characterIds = data.participantCharacterIds;
      let authUids = data.participantAuthUids;
      let origins = data.participantOrigins;
      let playerOne = get(playerPath(campaignId, playerIds[0])).data;
      let playerTwo = get(playerPath(campaignId, playerIds[1])).data;
      let characterOne = get(characterPath(campaignId, characterIds[0])).data;
      let characterTwo = get(characterPath(campaignId, characterIds[1])).data;
      return data.conversationType == 'players'
        && playerIds.size() == 2
        && characterIds.size() == 2
        && playerIds[0] != playerIds[1]
        && characterIds[0] != characterIds[1]
        && data.threadId == playerIds[0] + '::' + playerIds[1]
        && exists(playerPath(campaignId, playerIds[0]))
        && exists(playerPath(campaignId, playerIds[1]))
        && exists(characterPath(campaignId, characterIds[0]))
        && exists(characterPath(campaignId, characterIds[1]))
        && playerOne.authUid == authUids[0]
        && playerTwo.authUid == authUids[1]
        && playerOne.characterId == characterIds[0]
        && playerTwo.characterId == characterIds[1]
        && characterOne.controllerPlayerId == playerIds[0]
        && characterTwo.controllerPlayerId == playerIds[1]
        && characterOne.origin == origins[0]
        && characterTwo.origin == origins[1]
        && (
          (
            isCampaignMasterById(campaignId)
            && data.authorRole == 'master'
            && data.authorOrigin == 'Mestre'
          )
          || (
            data.authorRole == 'player'
            && (
              (
                request.auth.uid == authUids[0]
                && data.authorPlayerId == playerIds[0]
                && data.authorCharacterId == characterIds[0]
                && data.authorOrigin == origins[0]
              )
              || (
                request.auth.uid == authUids[1]
                && data.authorPlayerId == playerIds[1]
                && data.authorCharacterId == characterIds[1]
                && data.authorOrigin == origins[1]
              )
            )
          )
        );
    }

    function isValidMasterPrivateConversation(campaignId, data) {
      let playerIds = data.participantPlayerIds;
      let characterIds = data.participantCharacterIds;
      let authUids = data.participantAuthUids;
      let origins = data.participantOrigins;
      let player = get(playerPath(campaignId, playerIds[0])).data;
      let character = get(characterPath(campaignId, characterIds[0])).data;
      return data.conversationType == 'master-player'
        && playerIds.size() == 1
        && characterIds.size() == 1
        && data.threadId == 'master::' + playerIds[0]
        && exists(playerPath(campaignId, playerIds[0]))
        && exists(characterPath(campaignId, characterIds[0]))
        && authUids[0] == get(campaignPath(campaignId)).data.masterId
        && player.authUid == authUids[1]
        && player.characterId == characterIds[0]
        && character.controllerPlayerId == playerIds[0]
        && origins[0] == 'Mestre'
        && character.origin == origins[1]
        && (
          (
            isCampaignMasterById(campaignId)
            && data.authorRole == 'master'
            && data.authorOrigin == 'Mestre'
          )
          || (
            data.authorRole == 'player'
            && request.auth.uid == authUids[1]
            && data.authorPlayerId == playerIds[0]
            && data.authorCharacterId == characterIds[0]
            && data.authorOrigin == origins[1]
          )
        );
    }

    function isValidPrivateMessage(campaignId, docId) {
      let data = request.resource.data;
      let playerIds = data.participantPlayerIds;
      let characterIds = data.participantCharacterIds;
      let authUids = data.participantAuthUids;
      let origins = data.participantOrigins;
      return signedIn()
        && privateChatEnabled(campaignId, data.threadId)
        && data.id is string
        && data.id.size() > 0
        && data.threadId is string
        && data.threadId.size() > 0
        && data.conversationType is string
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 500
        && playerIds is list
        && characterIds is list
        && authUids is list
        && origins is list
        && authUids.size() == 2
        && origins.size() == 2
        && authUids[0] != authUids[1]
        && data.accessUid is string
        && data.accessUid in authUids
        && docId == data.id + '--' + data.accessUid
        && data.authorId == request.auth.uid
        && (
          (
            data.conversationType == 'players'
            && isValidPlayerPrivateConversation(campaignId, data)
          )
          || (
            data.conversationType == 'master-player'
            && isValidMasterPrivateConversation(campaignId, data)
          )
        )
        && data.keys().hasOnly([
          'id', 'threadId', 'conversationType', 'participantPlayerIds',
          'participantCharacterIds', 'participantAuthUids', 'participantOrigins',
          'accessUid', 'authorId', 'authorRole', 'authorPlayerId',
          'authorCharacterId', 'authorOrigin', 'text', 'time', 'sentAt', '_order'
        ]);
    }

    function isOwnIncomingTransfer(campaignId, docId) {
      let sourcePlayer = get(playerPath(campaignId, request.resource.data.fromPlayerId));
      return signedIn()
        && request.resource.data.id == docId
        && request.resource.data.status == 'pending'
        && request.resource.data.fromPlayerId is string
        && exists(playerPath(campaignId, request.resource.data.fromPlayerId))
        && sourcePlayer.data.authUid == request.auth.uid
        && request.resource.data.fromCharacterId == sourcePlayer.data.characterId
        && !request.resource.data.keys().hasAny(['resolvedAt', 'resolvedBy'])
        && (
          (
            request.resource.data.type == 'evidence'
            && request.resource.data.evidenceEntryId is string
            && request.resource.data.evidenceId is string
            && request.resource.data.toCharacterId is string
            && request.resource.data.fromCharacterId != request.resource.data.toCharacterId
            && exists(characterPath(campaignId, request.resource.data.toCharacterId))
          )
          || (
            request.resource.data.type == 'item'
            && request.resource.data.inventoryId is string
            && request.resource.data.toCharacterId is string
            && request.resource.data.fromCharacterId != request.resource.data.toCharacterId
            && exists(characterPath(campaignId, request.resource.data.toCharacterId))
            && request.resource.data.quantity is int
            && request.resource.data.quantity > 0
          )
        );
    }

    function isOwnControlledCharacter(campaignId, characterId) {
      let playerId = request.resource.data.controllerPlayerId;
      return signedIn()
        && playerId is string
        && exists(playerPath(campaignId, playerId))
        && get(playerPath(campaignId, playerId)).data.authUid == request.auth.uid
        && get(playerPath(campaignId, playerId)).data.characterId == characterId;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /campaigns/{campaignId} {
      // A senha atual da mesa e validada no cliente, portanto a busca direta por ID
      // precisa continuar disponivel a usuarios autenticados.
      allow get: if signedIn();
      allow list: if isCampaignMember();
      allow create: if isIncomingCampaignMember()
        && request.resource.data.masterId == request.auth.uid;
      allow update: if (
        signedIn() && resource.data.masterId == request.auth.uid
      ) || (
        isCampaignMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
      ) || (
        signedIn()
        && !(request.auth.uid in resource.data.members)
        && hasPreparedCharacterSlot()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
      );
      allow delete: if signedIn() && resource.data.masterId == request.auth.uid;

      match /players/{docId} {
        allow read: if isCampaignMemberById(campaignId);
        allow create: if isCampaignMemberById(campaignId)
          && (isCampaignMasterById(campaignId) || isValidPlayerSelfCreate(docId));
        allow update: if isCampaignMemberById(campaignId)
          && (isCampaignMasterById(campaignId) || canClaimPendingPlayer() || isValidOwnPlayerUpdate());
        allow delete: if isCampaignMasterById(campaignId);
      }

      match /messages/{docId} {
        allow read: if isCampaignMemberById(campaignId);
        allow create: if isCampaignMemberById(campaignId)
          && publicChatEnabled(campaignId)
          && (isCampaignMasterById(campaignId) || isOwnIncomingMessageOrLog());
        allow update, delete: if isCampaignMasterById(campaignId);
      }

      match /privateMessages/{docId} {
        allow read: if canReadPrivateMessage(campaignId);
        allow create: if isCampaignMemberById(campaignId)
          && isValidPrivateMessage(campaignId, docId);
        allow update: if false;
        allow delete: if isCampaignMasterById(campaignId);
      }

      match /diceLogs/{docId} {
        allow read: if isCampaignMemberById(campaignId);
        allow create: if isCampaignMemberById(campaignId)
          && (isCampaignMasterById(campaignId) || isOwnIncomingMessageOrLog());
        allow update, delete: if isCampaignMasterById(campaignId);
      }

      match /characters/{docId} {
        allow read: if isCampaignMemberById(campaignId);
        allow create, delete: if isCampaignMasterById(campaignId);
        allow update: if isCampaignMasterById(campaignId) || (
          isCampaignMemberById(campaignId)
          && isOwnControlledCharacter(campaignId, docId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'controllerPlayerId', 'health', 'sanity', 'skills'
          ])
        );
      }

      match /itemTransfers/{docId} {
        allow read: if isCampaignMemberById(campaignId);
        allow create: if isCampaignMemberById(campaignId)
          && (isCampaignMasterById(campaignId) || isOwnIncomingTransfer(campaignId, docId));
        allow update, delete: if isCampaignMasterById(campaignId);
      }

      match /scenes/{docId} {
        allow read, create, update, delete: if isCampaignMasterById(campaignId);
      }

      match /evidence/{docId} {
        allow read, create, update, delete: if isCampaignMasterById(campaignId);
      }

      match /{subcollection}/{docId} {
        allow read: if subcollection != 'scenes'
          && subcollection != 'evidence'
          && subcollection != 'messages'
          && subcollection != 'privateMessages'
          && isCampaignMemberById(campaignId);
        allow create, update, delete: if subcollection != 'scenes'
          && subcollection != 'evidence'
          && subcollection != 'messages'
          && subcollection != 'privateMessages'
          && isCampaignMasterById(campaignId);
      }
    }
  }
}
